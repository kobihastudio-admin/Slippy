{
  "name": "@slippy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key ./certs/localhost-key.pem --experimental-https-cert ./certs/localhost.pem",
    "dev:http": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:pdf": "tsx --tsconfig scripts/tsconfig.json scripts/verify-pdf.ts",
    "test:vat": "node --experimental-strip-types --test src/lib/vat.test.mjs",
    "test:security": "node --experimental-strip-types --test src/lib/liff-auth.test.mjs",
    "test:trips": "node --experimental-strip-types --test src/lib/trips/trip-conversation.test.mjs",
    "test:medications": "node --experimental-strip-types --test src/lib/medications.test.mjs",
    "test:medication-lifecycle": "node --experimental-strip-types --test src/lib/medication-lifecycle.test.mjs",
    "test:location-sharing": "node --experimental-strip-types --test src/lib/trips/location-sharing.test.mjs",
    "test:calls": "node --experimental-strip-types --test src/lib/trips/calls.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@googlemaps/js-api-loader": "^2.1.1",
