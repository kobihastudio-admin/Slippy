    "@supabase/ssr": "^0.4.0",
    "@supabase/supabase-js": "^2.43.0",
    "@types/google.maps": "^3.65.5",
    "@types/qrcode": "^1.5.6",
    "bullmq": "^5.79.2",
    "clsx": "^2.1.1",
    "file-type": "^19.6.0",
    "heic2any": "^0.0.4",
    "ioredis": "^5.11.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "livekit-client": "^2.22.1",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^0.395.0",
    "next": "15.5.18",
    "next-intl": "^3.15.0",
    "next-themes": "^0.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.2.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.12.0",
    "sonner": "^1.5.0",
