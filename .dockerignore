# Docker build context for synology-container-stack/apps/{web,api}/Dockerfile
# uses the repo root as context (so npm workspaces resolve correctly) — this
# keeps that context small. Native-app folders (ios/, mobile/) and anything
# already excluded from git are irrelevant to the web/api containers.

node_modules
**/node_modules
.next
**/.next
dist
**/dist
.git
.turbo
coverage

# Native app projects — never needed to build web/api containers
ios
mobile
android

# Local env files — real secrets are passed in via docker-compose env_file,
# never baked into the image
.env
.env.local
.env*.local
**/.env
**/.env.local

# Editor/OS noise
.DS_Store
.vscode
.idea

# Supabase CLI local state
.supabase
supabase/.branches
supabase/.temp

# This stack's own NAS-side state (Supabase self-hosted clone, generated by
# bootstrap-supabase.sh) — not needed inside the web/api image build
synology-container-stack/supabase

# Local agent workspaces and design prototypes
.worktrees
.claude
.codex
prototypes
