# Copy to web.env (gitignored) — runtime-only env vars for the `web`
# container. These are server-side secrets, never inlined into the JS
# bundle — that's what the NEXT_PUBLIC_* build args in .env/docker-compose
# are for instead. Values below mirror web/.env.local — copy the real ones
# from there rather than retyping them.

SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Must match api.env's INTERNAL_API_KEY exactly — web calls api over the
# docker network using this shared secret (x-internal-key header).
INTERNAL_API_KEY=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Numeric channel ID + secret for the LINE Login flow (/api/auth/line,
# /api/auth/line/callback) — usually the same channel as
# NEXT_PUBLIC_LINE_CHANNEL_ID / LINE_CHANNEL_SECRET above, but these are
# separate env vars (checked explicitly in line/callback/route.ts) so both
# must be set even when the value is identical.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_SECRET=

# Shared secret for cron-triggered internal endpoints (currently
# /api/trips/recurring/run) — must match the Supabase Edge Function's
# CRON_SECRET (Dashboard → Edge Functions → generate-recurring-expenses →
# Secrets). Same permissive-when-unset pattern as reset-org-quotas: set this
# in production, but local dev works without it.
CRON_SECRET=
