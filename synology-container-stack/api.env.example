# Copy to api.env (gitignored) — runtime env vars for the `api` container.
# Mirrors api/.env.example — copy real values from your actual api/.env
# rather than retyping them. PORT/REDIS_URL/SMTP_* are already set directly
# in docker-compose.yml's `environment:` block for this service — don't
# duplicate them here.

INTERNAL_API_KEY=   # must match web.env's INTERNAL_API_KEY exactly

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

ANTHROPIC_API_KEY=

GOOGLE_CLOUD_PROJECT=
GOOGLE_DOC_AI_LOCATION=us
GOOGLE_DOC_AI_PROCESSOR_ID=
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

ENCRYPTION_KEY=

EMAIL_DOMAIN=
CLOUDFLARE_API_TOKEN=

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

SUPABASE_STORAGE_BUCKET=documents
MAX_FILE_SIZE_MB=20
