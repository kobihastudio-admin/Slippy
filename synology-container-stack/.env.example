# Copy to .env and adjust for your NAS.
#
# This file holds: (1) compose-level settings (ports, NAS host), and
# (2) NEXT_PUBLIC_* values for web's build args — these are NOT secret
# (they're inlined into the client-side JS bundle by design), so it's fine
# for them to live in a plain .env. Server-only secrets go in web.env and
# api.env instead (copy from web.env.example / api.env.example) — those are
# gitignored and never baked into a Docker image layer.

COMPOSE_PROJECT_NAME=slippy-dev

# NAS hostnames, for the *local-only* Caddy proxy. For first run, IP
# addresses are fine. Unrelated to the public hostnames you'll set up in the
# Cloudflare Tunnel dashboard.
NAS_HOST=192.168.1.200
WEB_DOMAIN=web.local
API_DOMAIN=api.local
SUPABASE_DOMAIN=supabase.local

# Local exposed ports. Change if Synology already uses them.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
WEB_PORT=3000
API_PORT=4000
REDIS_PORT=6379
MAILPIT_WEB_PORT=8025

# App runtime defaults.
NODE_ENV=production
APP_ENV=staging

# Supabase self-hosted gateway port is configured in supabase/.env.
# Official default: http://<NAS_HOST>:8000
SUPABASE_PUBLIC_URL=http://192.168.1.200:8000
SUPABASE_ANON_KEY=replace_after_supabase_bootstrap
SUPABASE_SERVICE_ROLE_KEY=replace_after_supabase_bootstrap

# ── Cloudflare Tunnel (replaces ngrok) ──────────────────────────────────────
# Create once: Cloudflare Zero Trust dashboard → Networks → Tunnels →
# Create a tunnel → connector type "Docker" → copy the token it gives you.
# Then add two Public Hostnames in that same tunnel's config (in the
# dashboard, not here): one → http://web:3000, one → http://api:4000.
CLOUDFLARE_TUNNEL_TOKEN=

# ── NEXT_PUBLIC_* — baked into web's JS bundle at build time ────────────────
# Copy real values from web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set this to whatever public hostname you register for `web` in the
# Cloudflare Tunnel (e.g. https://dev.yourdomain.com).
NEXT_PUBLIC_APP_URL=
# Set this to whatever public hostname you register for `api`.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LINE_BOT_ID=
NEXT_PUBLIC_LINE_CHANNEL_ID=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_PACK_100=
NEXT_PUBLIC_STRIPE_PRICE_PACK_300=
NEXT_PUBLIC_STRIPE_PRICE_PACK_500=
